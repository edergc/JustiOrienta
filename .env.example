# Copia este archivo como ".env" y ajusta los valores.
# Todas las herramientas involucradas son de código abierto y sin costo de licencia.

# SQLite por defecto (cero instalación). Para PostgreSQL en producción:
# DATABASE_URL=postgresql+psycopg2://usuario:clave@host:5432/justicia_orienta
DATABASE_URL=sqlite:///./justicia_orienta.db

# Cambia esta clave antes de cualquier uso real -- firma los tokens de sesión.
JUSTICIA_ORIENTA_SECRET=cambia-esta-clave-antes-de-produccion
