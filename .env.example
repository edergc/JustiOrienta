# Copia este archivo como ".env" y ajusta los valores.
# Todas las herramientas involucradas son de código abierto y sin costo de licencia.

# desarrollo | produccion -- en "produccion", el servidor se niega a arrancar si
# JUSTICIA_ORIENTA_SECRET sigue con el valor de relleno de abajo (ver app/main.py).
ENTORNO=desarrollo

# SQLite por defecto (cero instalación). Para PostgreSQL en producción:
# DATABASE_URL=postgresql+psycopg2://usuario:clave@host:5432/justicia_orienta
DATABASE_URL=sqlite:///./justicia_orienta.db

# Cambia esta clave antes de cualquier uso real -- firma los tokens de sesión.
JUSTICIA_ORIENTA_SECRET=cambia-esta-clave-antes-de-produccion

# URL pública real del sitio -- se usa para armar el enlace del correo de
# "olvidé mi contraseña" (…/admin?reset=token). En desarrollo local, deja el
# valor por defecto.
URL_PUBLICA=http://localhost:8743

# Correo saliente, solo para "olvidé mi contraseña" -- cualquier SMTP (institucional
# o de prueba), sin servicio de terceros. Si SMTP_HOST queda vacío (como abajo), el
# correo no se envía de verdad: se registra en el log, para poder probar el flujo
# completo sin credenciales reales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=Justicia Orienta <no-responder@justiciaorienta.local>
